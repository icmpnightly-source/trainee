# Nusxa oling: cp .env.example .env  (.env git'ga tushmaydi)

PORT=8080
HOST=0.0.0.0
# Ma'lumotlar bazasi va tahrirlangan normativlar shu papkada (server/ ga nisbatan)
DATA_DIR=var

# --- AI murabbiy (OpenAI-ga mos har qanday API) ---
# DeepSeek:
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-v4-pro
# Lokal model (Ollama) bilan ishlatish uchun:
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_API_KEY=
# AI_MODEL=qwen3:8b
AI_TIMEOUT_MS=180000
AI_MAX_TOKENS=6000
# Model response_format=json_object ni qo'llamasa: false
AI_JSON_MODE=true

# --- Lokal OSRM (docker compose up -d osrm) ---
OSRM_URL=http://127.0.0.1:5000
OSRM_PROFILE=foot

# --- Xarita ---
# Lokal tile server bo'lsa, uning manzilini yozing, masalan:
# TILE_URL=http://127.0.0.1:8081/styles/basic-preview/{z}/{x}/{y}.png
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=© OpenStreetMap
MAP_CENTER=41.3111,69.2797

# --- HTTPS (telefonda kamera va GPS uchun kerak) ---
# ../scripts/make-cert.sh bilan yarating
# HTTPS_CERT=var/cert.pem
# HTTPS_KEY=var/key.pem
